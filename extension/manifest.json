{
  "manifest_version": 3,
  "name": "PacedLearner — Pacey LeetCode FSRS Observer",
  "version": "1.2.0",
  "description": "Pacey observes your LeetCode coding actions, errors, and submissions in real time and syncs solves to your FSRS mastery hub.",
  "permissions": [
    "storage",
    "activeTab",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "*://*.leetcode.com/*",
    "http://localhost:4100/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://leetcode.com/problems/*"
      ],
      "js": ["interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://leetcode.com/problems/*"
      ],
      "js": ["pacey-engine.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["interceptor.js", "pacey-engine.js"],
      "matches": ["*://leetcode.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PacedLearner — Pacey FSRS Observer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
